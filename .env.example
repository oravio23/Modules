# Shared Supabase project — one project, one JWT issuer, so every module shares a session.
# Never put a service-role key behind a VITE_ prefix; it must stay server-side only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Off by default: neither Google nor Microsoft OAuth is configured on any Supabase
# project yet (both fail provider-not-enabled). Set to "true" only after registering both
# providers — see docs/deploy-checklist.md.
VITE_ENABLE_OAUTH=false
