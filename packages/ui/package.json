{
  "name": "@oravio/ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "comment": "This package is never installed by an app. It is the authored source for the component template registry vendored into every app/* by scripts/sync-ui.mjs, so every app stays a flat, dependency-free-of-monorepo Vite project that can be dropped into Lovable directly (same as M5). These dependencies exist only so this package typechecks in isolation; each app declares its own copies as real dependencies after sync.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "lint": "eslint --config ../../eslint.config.js src",
    "test": "echo \"no tests yet\" && exit 0"
  },
