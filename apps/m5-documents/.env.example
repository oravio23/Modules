# Copy this file to .env.local for local development (Vite loads .env.local
# automatically; it's gitignored). Get these values from `supabase status`
# after `supabase start`, or from the Supabase dashboard for a hosted project.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Server-side only — set via `supabase secrets set ANTHROPIC_API_KEY=sk-ant-...`,
# NEVER as a VITE_ variable and NEVER committed here. Listed for reference only.
# ANTHROPIC_API_KEY=
