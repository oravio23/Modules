{
  "name": "@oravio/m5-documents",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/copy-pdfjs-assets.mjs && node scripts/vendor-shared.mjs && tsc -b --force && vite build",
    "preview": "vite preview",
    "lint": "eslint --config ../../eslint.config.js .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit --force",
    "postinstall": "node scripts/copy-pdfjs-assets.mjs && node scripts/vendor-shared.mjs",
    "fixtures": "tsx scripts/generate-fixtures.ts",
    "specs": "tsx scripts/export-specs.ts && tsx scripts/generate-seed.ts",
    "eval": "tsx scripts/eval.ts"
  },
