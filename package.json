{
  "name": "oravio-modules",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "dev:shell": "pnpm --filter @oravio/shell dev",
    "dev": "concurrently -n shell,m5 -c blue,green \"pnpm --filter @oravio/shell dev\" \"pnpm --filter @oravio/m5-documents dev\"",
    "sync": "node scripts/sync-ui.mjs --all"
  },
  "comment": "ajv/ajv-formats/jszip are here (not just apps/m5-documents/package.json) because supabase/functions/_shared/*.test.ts run under Node from their own file location — module resolution walks up from there, and this shared code is a repo-root-level concern any module could end up depending on, not owned by one app.",
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "jszip": "^3.10.1",
    "typescript": "^5.6.3",
    "prettier": "^3.4.2",
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "typescript-eslint": "^8.18.2"
  }
}
