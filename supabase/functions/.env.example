# Copy this file to supabase/functions/.env for local development (gitignored — `.env` is
# ignored repo-wide). `supabase start` loads it automatically for every local edge function
# invocation. On a cloud project, set the same names with `supabase secrets set NAME=value`
# instead — this file is never read there.

# Required by pipeline-worker (see _shared/pipelineAuth.ts) and by documents-register's
# fire-and-forget call into it. Any fixed value works locally; use a real random one in
# production (`openssl rand -hex 32`).
PIPELINE_WORKER_SECRET=local-dev-pipeline-secret

# Required by documents-register's Anthropic Files API upload and pipeline-worker's
# transcribe/classify/extract stages. Never committed for real — get a key from
# console.anthropic.com for local testing.
# ANTHROPIC_API_KEY=
